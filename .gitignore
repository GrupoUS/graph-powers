# Local execution state — never versioned.
AGENT_STOP
.claude/logs/
.graph-powers/logs/
.graph-powers/cache/
.graph-powers/installed.json
.claude/settings.local.json
# Scan artefacts of `skill-improve` Mode B (inventory, graph, contract, captured eval responses).
# The skill may write there freely because nothing there is authored; it is regenerated per round.
.claude/audit/

# Generated for Codex: these embed this machine's plugin path and are regenerated
# per machine by `bunx graph-powers --target codex`.
.codex/hooks.json
.codex/agents/
.agents/skills/
# `node codex/native-plugin.mjs --models … --out <dir>` writes native agents carrying THIS
# account's Codex slugs. The tracked copies under `codex/native-agents/` never carry one.
.graph-powers/codex-native/
# `.codex/rules/` is deliberately NOT ignored in a project that installs the plugin: the rules are
# copied as a starting point and then edited, which is why the uninstaller preserves them. Here it
# can only be residue — the installer refuses to run against the plugin's own checkout, so the only
# way it appears is a test invocation, and what it contains is a byte-identical copy of
# `templates/rules/`. Committing that would be this repository duplicating itself.
.codex/rules/

# Packaging artefacts
*.tgz
node_modules/

# Python cache (the hooks are stdlib, but the interpreter leaves this behind)
__pycache__/
*.pyc

# Linter caches. The configuration is versioned (`ruff.toml`, `pyrightconfig.json`); what the
# tools memoise between runs is per machine.
.ruff_cache/

# Operating system
.DS_Store
Thumbs.db
