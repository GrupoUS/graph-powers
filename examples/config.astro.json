{
  "$schema": "https://raw.githubusercontent.com/GrupoUS/graph-powers/main/schema/config.schema.json",
  "project": {
    "name": "acme-site",
    "displayName": "Acme Site",
    "stack": "astro-static-tailwindv4",
    "locale": "en-US",
    "productionUrl": "https://acme.example"
  },
  "git": {
    "workBranch": "dev-test",
    "protectedBranches": ["main"],
    "optInPrefix": "ACMESITE"
  },
  "graphGuardrails": {
    "maxSpawnsPerSession": 16,
    "maxRoundsPerAgent": 4,
    "maxParallelWave": 2,
    "spawnWindowMinutes": 60
  },
  "tooling": {
    "packageManager": "bun",
    "typeChecker": "vtsls",
    "linter": "oxlint",
    "buildTool": "astro",
    "testRunner": null,
    "commands": {
      "typeCheck": "bun run type-check",
      "lint": "bun run lint --",
      "format": "bun run format --",
      "build": "bun run build"
    }
  },
  "paths": {
    "frontendRoot": "src",
    "componentsRoot": "src/components",
    "stylesRoot": "src/styles"
  }
}
