{
  "$schema": "https://raw.githubusercontent.com/GrupoUS/graph-powers/main/schema/config.schema.json",
  "project": {
    "name": "acme-app",
    "displayName": "Acme App",
    "stack": "bun-ts",
    "locale": "en-US"
  },
  "git": {
    "workBranch": "dev-test",
    "protectedBranches": ["main"]
  },
  "tooling": {
    "packageManager": "bun",
    "typeChecker": "vtsls",
    "linter": "oxlint",
    "testRunner": "bun-test",
    "commands": {
      "typeCheck": "bun run type-check",
      "lint": "bun run lint --",
      "format": "bun run format --",
      "test": "bun test --smol",
      "build": "bun run build"
    }
  }
}
