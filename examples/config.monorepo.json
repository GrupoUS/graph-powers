{
  "$schema": "https://raw.githubusercontent.com/GrupoUS/graph-powers/main/schema/config.schema.json",
  "project": {
    "name": "acme-platform",
    "displayName": "Acme Platform",
    "stack": "monorepo-bun-trpc-drizzle-postgres-react19",
    "locale": "en-US",
    "stagingUrl": "https://staging.acme.example",
    "productionUrl": "https://acme.example"
  },
  "git": {
    "workBranch": "dev-test",
    "protectedBranches": ["main", "master"],
    "optInPrefix": "ACMEPLATFORM"
  },
  "graphGuardrails": {
    "maxSpawnsPerSession": 16,
    "maxRoundsPerAgent": 4,
    "maxParallelWave": 2,
    "spawnWindowMinutes": 60
  },
  "tooling": {
    "packageManager": "bun",
    "typeChecker": "vtsls",
    "linter": "oxlint",
    "buildTool": "turbo",
    "testRunner": "vitest",
    "commands": {
      "typeCheck": "bun run type-check",
      "lint": "bun run lint --",
      "format": "bun run format --",
      "test": "bun run test",
      "build": "bun run build"
    }
  },
  "paths": {
    "frontendRoot": "apps/web/src",
    "backendRoot": "apps/api/src",
    "schemaRoot": "apps/api/drizzle",
    "componentsRoot": "apps/web/src/components",
    "libRoot": "apps/web/src/lib",
    "planDir": "docs/plans"
  },
  "database": {
    "engine": "postgres",
    "commands": {
      "status": "bun run db:status",
      "generate": "bun run db:generate",
      "apply": "bun run db:migrate"
    },
    "applyPolicy": "optIn"
  },
  "codex": {
    "profiles": {
      "judge": { "model": "gpt-5.6-sol", "reasoningEffort": "max" },
      "executor": { "model": "gpt-5.6-luna", "reasoningEffort": "max" },
      "scout": { "model": "gpt-5.6-luna", "reasoningEffort": "medium" }
    }
  }
}
